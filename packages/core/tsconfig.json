{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"tsBuildInfoFile": "./.tsbuildinfo",
		"types": [
			"node",
			"bun"
		]
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	],
	"references": [
		{
			"path": "../channels"
		},
		{
			"path": "../ai"
		},
		{
			"path": "../lib"
		}
	]
}
