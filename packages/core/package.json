{
	"name": "@rho/core",
	"version": "0.0.0",
	"description": "Importable core runtime, state, database, and channel management for rho.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsgo -b tsconfig.json",
		"db:generate": "prisma generate --config prisma.config.ts",
		"db:migrate": "prisma migrate dev --config prisma.config.ts",
		"db:seed": "bun prisma/seed.ts",
		"typecheck": "tsgo -b tsconfig.json --pretty false",
		"clean": "rm -rf dist .tsbuildinfo *.tsbuildinfo"
	},
	"dependencies": {
		"@libsql/client": "0.17.3",
		"@orpc/server": "^1.12.0",
		"@prisma/adapter-libsql": "7.8.0",
		"@prisma/client": "7.8.0",
		"@rho/ai": "0.0.0",
		"@rho/channels": "0.0.0",
		"@rho/lib": "0.0.0",
		"dotenv": "17.2.3",
		"jiti": "2.7.0"
	},
	"devDependencies": {
		"prisma": "7.8.0"
	},
	"keywords": [
		"ai",
		"agents",
		"core"
	],
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	}
}
