generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

enum Relationship {
  BookClub
  Family
  Friend
  Gym
  Neighbor
  RunningGroup
}

model Contact {
  id              Int          @id @default(autoincrement())
  name            String
  relationship    Relationship
  email           String?      @unique
  phone           String?
  city            String?
  region          String?
  country         String?
  birthday        DateTime?
  notes           String?
  favorite        Boolean      @default(false)
  lastContactedAt DateTime     @map("last_contacted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  orgs Org[]

  @@map("contacts")
}

model Org {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members Contact[]

  @@map("orgs")
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("todos")
}

model PlannedExercise {
  id        Int      @id @default(autoincrement())
  date      String
  name      String
  details   String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date, sortOrder])
  @@map("planned_exercises")
}

enum TaskStatus {
  queued
  running
  done
  failed
}

model Task {
  id              String     @id
  conversationKey String     @map("conversation_key")
  channelId       String     @map("channel_id")
  targetType      String     @map("target_type")
  targetId        String     @map("target_id")
  title           String
  instructions    String
  status          TaskStatus @default(queued)
  attempt         Int        @default(0)
  error           String?
  summary         String?
  sessionFile     String?    @map("session_file")
  runAfter        DateTime?  @map("run_after")
  heartbeatAt     DateTime?  @map("heartbeat_at")
  notifiedAt      DateTime?  @map("notified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@map("_rho_tasks")
}

model SystemOwner {
  id               Int      @id
  passwordHash     String   @map("password_hash")
  setupCompletedAt DateTime @map("setup_completed_at")

  @@map("_rho_system_owner")
}

model SystemSession {
  id               String    @id
  accessTokenHash  String    @unique @map("access_token_hash")
  refreshTokenHash String?   @unique @map("refresh_token_hash")
  accessExpiresAt  DateTime  @map("access_expires_at")
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("_rho_system_sessions")
}

model SystemApiToken {
  id          String    @id
  name        String
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("_rho_system_api_tokens")
}
