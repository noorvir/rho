generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// rho_sys_* models are rho-owned system tables: read-only infrastructure.
// Never edit, rename, remove, or write to them. rho refuses to load a schema
// that lost any of them.
// ---------------------------------------------------------------------------

enum rho_sys_TaskStatus {
  queued
  running
  done
  failed
}

enum rho_sys_CronKind {
  extension
  agent
}

enum rho_sys_CronScheduleKind {
  at
  cron
}

enum rho_sys_CronStatus {
  not_run
  running
  succeeded
  failed
}

enum rho_sys_CronPurpose {
  REMINDER       @map("reminder")
  SCHEDULED_TASK @map("scheduled_task")
}

enum rho_sys_NotificationLevel {
  info
  attention
  urgent
}

model rho_sys_Task {
  id              String             @id
  conversationKey String             @map("conversation_key")
  channelId       String             @map("channel_id")
  targetType      String             @map("target_type")
  targetId        String             @map("target_id")
  title           String
  instructions    String
  status          rho_sys_TaskStatus @default(queued)
  attempt         Int                @default(0)
  error           String?
  summary         String?
  sessionFile     String?            @map("session_file")
  runAfter        DateTime?          @map("run_after")
  heartbeatAt     DateTime?          @map("heartbeat_at")
  notifiedAt      DateTime?          @map("notified_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@map("rho_sys_tasks")
}

model rho_sys_Cron {
  id           String                   @id
  kind         rho_sys_CronKind
  title        String
  scheduleKind rho_sys_CronScheduleKind @map("schedule_kind")
  schedule     String
  timezone     String
  enabled      Boolean                  @default(true)
  status       rho_sys_CronStatus       @default(not_run)
  nextRunAt    DateTime                 @map("next_run_at")
  lastRunAt    DateTime?                @map("last_run_at")
  lastError    String?                  @map("last_error")
  activeRunId  String?                  @map("active_run_id")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  purpose         rho_sys_CronPurpose @default(SCHEDULED_TASK)
  instructions    String?
  conversationKey String?             @map("conversation_key")
  channelId       String?             @map("channel_id")
  targetType      String?             @map("target_type")
  targetId        String?             @map("target_id")
  extensionId     String?             @map("extension_id")
  icon            String?

  @@index([nextRunAt])
  @@index([extensionId])
  @@map("rho_sys_crons")
}

model rho_sys_Notification {
  id             String                    @id
  defKey         String                    @map("def_key")
  extensionId    String                    @map("extension_id")
  defId          String                    @map("def_id")
  title          String
  body           String
  level          rho_sys_NotificationLevel
  icon           String?
  targetType     String?                   @map("target_type")
  targetId       String?                   @map("target_id")
  idempotencyKey String                    @map("idempotency_key")
  readAt         DateTime?                 @map("read_at")
  dismissedAt    DateTime?                 @map("dismissed_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  @@unique([defKey, idempotencyKey])
  @@index([dismissedAt, createdAt])
  @@index([extensionId, defId])
  @@map("rho_sys_notifications")
}

model rho_sys_Owner {
  id               Int      @id
  passwordHash     String   @map("password_hash")
  setupCompletedAt DateTime @map("setup_completed_at")

  @@map("rho_sys_owner")
}

model rho_sys_Session {
  id               String    @id
  accessTokenHash  String    @unique @map("access_token_hash")
  refreshTokenHash String?   @unique @map("refresh_token_hash")
  accessExpiresAt  DateTime  @map("access_expires_at")
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("rho_sys_sessions")
}

model rho_sys_ApiToken {
  id          String    @id
  name        String
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("rho_sys_api_tokens")
}

// ---------------------------------------------------------------------------
// Shared personal-data models seeded into every runtime. Extensions may
// evolve these with non-destructive migrations.
// ---------------------------------------------------------------------------

enum Relationship {
  BookClub
  Family
  Friend
  Gym
  Neighbor
  RunningGroup
}

model Contact {
  id              Int          @id @default(autoincrement())
  name            String
  relationship    Relationship
  email           String?      @unique
  phone           String?
  city            String?
  region          String?
  country         String?
  birthday        DateTime?
  notes           String?
  favorite        Boolean      @default(false)
  lastContactedAt DateTime     @map("last_contacted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  orgs Org[]

  @@map("contacts")
}

model Org {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members Contact[]

  @@map("orgs")
}
