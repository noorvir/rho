import { useQuery } from "@tanstack/react-query";
import { EmptyState, ErrorState, List, LoadingState, Row, Screen, Section } from "@rho/ui";
import { useApi } from "../client.ts";

export function Home() {
	const api = useApi();
	const items = useQuery(api.items.queryOptions());

	return (
		<Screen title="__APP_NAME__">
			<Section title="Items">
				{items.isPending && <LoadingState />}
				{items.isError && <ErrorState description="Could not load items. Please try again." />}
				{items.data && items.data.items.length === 0 && (
					<EmptyState title="Nothing here yet" description="Items you add will show up here." />
				)}
				{items.data && items.data.items.length > 0 && (
					<List>
						{items.data.items.map((item) => (
							<Row key={item.id} title={item.name} />
						))}
					</List>
				)}
			</Section>
		</Screen>
	);
}
