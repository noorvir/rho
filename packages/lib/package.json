{
	"name": "@rho/lib",
	"version": "0.0.0",
	"description": "Small shared utilities for rho packages.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsgo -b tsconfig.json",
		"typecheck": "tsgo -b tsconfig.json --pretty false",
		"clean": "rm -rf dist .tsbuildinfo *.tsbuildinfo"
	},
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	}
}
