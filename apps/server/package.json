{
	"name": "@rho/server",
	"version": "0.0.0",
	"private": true,
	"description": "HTTP server app for rho.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"rho-server": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "bun src/dev.ts",
		"build": "bun run web:build && tsgo -b tsconfig.json",
		"web:build": "tsgo -b web/tsconfig.json && vite build --config web/vite.config.ts",
		"typecheck": "tsgo -b tsconfig.json --pretty false && tsgo -b web/tsconfig.json --pretty false",
		"clean": "rm -rf dist web/dist .tsbuildinfo *.tsbuildinfo web/.tsbuildinfo web/*.tsbuildinfo"
	},
	"dependencies": {
		"@base-ui/react": "1.5.0",
		"@fontsource-variable/geist": "5.2.9",
		"@hono/node-server": "^1.14.4",
		"@orpc/client": "^1.12.0",
		"@orpc/contract": "1.14.5",
		"@orpc/openapi": "1.14.5",
		"@orpc/openapi-client": "1.14.5",
		"@orpc/react-query": "1.14.5",
		"@orpc/server": "^1.12.0",
		"@rho/apps-sdk": "0.0.0",
		"@rho/channels": "0.0.0",
		"@rho/core": "0.0.0",
		"@rho/lib": "0.0.0",
		"@tabler/icons-react": "3.44.0",
		"@tanstack/react-query": "5.101.0",
		"@tanstack/react-router": "^1.139.3",
		"@tanstack/react-table": "8.21.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"date-fns": "4.4.0",
		"embla-carousel-react": "8.6.0",
		"hono": "^4.7.11",
		"input-otp": "1.4.2",
		"lucide-react": "1.17.0",
		"next-themes": "0.4.6",
		"radix-ui": "1.5.0",
		"react": "^19.2.1",
		"react-day-picker": "10.0.1",
		"react-dom": "^19.2.1",
		"react-resizable-panels": "4.11.2",
		"recharts": "3.8.0",
		"shadcn": "4.10.0",
		"sonner": "2.0.7",
		"tailwind-merge": "3.6.0",
		"tw-animate-css": "1.4.0",
		"vaul": "1.1.2",
		"zod": "4.4.3"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.17",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"tailwindcss": "^4.1.17",
		"vite": "^7.2.6"
	}
}
